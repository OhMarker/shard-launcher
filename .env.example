# Azure app registration (consumers tenant) client id. Required for Microsoft sign-in.
# See README.md section "Microsoft sign-in setup".
MSA_CLIENT_ID=

# Optional. Overrides the hosted Shard client manifest URL.
SHARD_MANIFEST_URL=

# Optional. Overrides the hosted bundled-mods manifest URL.
SHARD_BUNDLED_MODS_URL=

# Optional. Overrides the hosted cosmetics manifest URL.
SHARD_COSMETICS_URL=

# Optional. Contact info placed in the Modrinth User-Agent (email or URL).
MODRINTH_CONTACT=
