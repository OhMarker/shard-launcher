{
  "name": "shard-launcher",
  "productName": "Shard Launcher",
  "version": "0.2.1",
  "description": "Shard Launcher - Sharpen your crystal PvP.",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Shard",
    "email": "launcher@shard.invalid"
  },
  "homepage": "https://github.com/OhMarker/shard-launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/OhMarker/shard-launcher.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "tsx scripts/generate-icons.ts",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run typecheck && npm run build && electron-builder",
    "dist:win": "npm run typecheck && npm run build && electron-builder --win",
    "dist:mac": "npm run typecheck && npm run build && electron-builder --mac",
    "dist:linux": "npm run typecheck && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "framer-motion": "^14.0.0",
    "globals": "^16.0.0",
    "lucide-react": "^1.52.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "skinview3d": "^3.4.2",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=20"
  }
}
